# Keep all Claude configurations
# This repo is specifically for Claude Code settings

# But exclude any potential sensitive data
*.backup
*.tmp
.DS_Store

# Exclude existing local files and directories
ide/
projects/
shell-snapshots/
statsig/
todos/
claude-settings-temp/
__pycache__/
evals/monthly-sweep/logs/
evals/reports/*-sweep.md

# generated ratchet state for claude-md-tier-lint.py
tools/.claude-md-budget.json

# wayfinder run-telemetry cache: the map-*.yaml and INDEX.md ARE committed (they
# carry the cross-map view a fresh session reads), but the writer lock is not.
skills/wayfinder/runs/.lock
